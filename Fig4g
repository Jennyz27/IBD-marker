# ==============================================================================
# Quadrant Scatter Plot and Marginal Density Plot Generation Pipeline
# ==============================================================================

library(ggplot2)
library(ggExtra)
library(dplyr)

# 1. Load and filter data for quadrant plot
data <- read.csv("182_usingFC_ddPCRmodel.csv", row.names = 1)
filtered_data <- data %>% filter(!is.na(FC) & FC >= 50 & FC <= 250)

# Calculate counts dynamically for plot annotations
count_IBD_above <- sum(filtered_data$IBD > 0.681686 & filtered_data$group == "IBD")
count_Controls_above <- sum(filtered_data$IBD > 0.681686 & filtered_data$group == "Controls")
count_IBD_below <- sum(filtered_data$IBD <= 0.681686 & filtered_data$group == "IBD")
count_Controls_below <- sum(filtered_data$IBD <= 0.681686 & filtered_data$group == "Controls")

# Assign quadrant categories
filtered_data <- filtered_data %>%
  mutate(quadrant = case_when(
    IBD > 0.681686 & group == "IBD" ~ "Q1",
    IBD > 0.681686 & group == "Controls" ~ "Q2",
    IBD <= 0.681686 & group == "IBD" ~ "Q3",
    IBD <= 0.681686 & group == "Controls" ~ "Q4"
  ))

# 2. Create and save Quadrant Scatter Plot
p_axis <- ggplot(filtered_data, aes(x = FC, y = IBD, color = group)) +
  geom_point(alpha = 0.8, size = 3) +
  geom_hline(yintercept = 0.681686, linetype = "dashed", color = "red", size = 1) +
  scale_color_manual(values = c("IBD" = "#D7191C", "Controls" = "#2C7BB6")) +
  labs(
    x = "Fecal calprotectin",
    y = "Probability of disease using 6 Bac markers + FC", 
    color = "group"
  ) +
  theme_minimal(base_size = 14) +
  theme(
    legend.position = "bottom",
    panel.grid = element_blank(),
    axis.title = element_text(face = "bold"),
    axis.text = element_text(color = "black", size = 15),
    legend.title = element_text(face = "bold"),
    legend.text = element_text(color = "black", size = 15),
    plot.background = element_rect(fill = "transparent", color = NA),
    panel.background = element_rect(fill = "transparent", color = NA),
    panel.border = element_rect(fill = NA, color = "black", size = 0.8, linetype = "solid")
  ) +
  scale_y_continuous(limits = c(0.12, 1.08), breaks = seq(0, 1, 0.2), expand = c(0.01, 0)) +
  scale_x_continuous(limits = c(49, 252), breaks = seq(50, 250, 50), expand = c(0.01, 0)) +
  annotate("text", x = 160, y = 1.06, label = paste("IBD:", count_IBD_above), fontface = "bold", color = "black", size = 7, hjust = 0) +
  annotate("text", x = 136, y = 1.01, label = paste("Controls:", count_Controls_above), fontface = "bold", color = "black", size = 7, hjust = 0) +
  annotate("text", x = 160, y = 0.2, label = paste("IBD:", count_IBD_below), fontface = "bold", color = "black", size = 7, hjust = 0) +
  annotate("text", x = 136, y = 0.15, label = paste("Controls:", count_Controls_below), fontface = "bold", color = "black", size = 7, hjust = 0)

ggsave(filename = "GI_P_AXIS_DDPCR+FC.png", plot = p_axis, width = 6.4, height = 7.4, dpi = 600)

# 3. Create and save Marginal Density Plot
data_full <- data %>% filter(!is.na(FC))

p_main <- ggplot(data_full, aes(x = log10(FC + 10), y = IBD, color = group)) +
  geom_point(alpha = 0.6, size = 1.5) +
  geom_density_2d(aes(linetype = group), size = 1) +
  geom_rug(sides = "tr", alpha = 0.5) +
  scale_color_manual(values = c("IBD" = "#D7191C", "Controls" = "#2C7BB6")) +
  labs(
    x = "Log10(Fecal calprotectin + 10)", 
    y = "Probability of disease\nUsing 6 Bac markers", 
    color = "group"
  ) +
  theme_minimal(base_size = 14) +
  theme(
    legend.position = "bottom",
    panel.grid = element_blank(),
    axis.title = element_text(face = "bold"),
    axis.text = element_text(color = "black"),
    legend.title = element_text(face = "bold"),
    legend.text = element_text(color = "black", size = 15),
    plot.background = element_rect(fill = "transparent", color = NA),
    panel.background = element_rect(fill = "transparent", color = NA),
    panel.border = element_rect(fill = NA, color = "black", size = 0.8, linetype = "solid")
  ) +
  scale_y_continuous(limits = c(0.1, 1), breaks = seq(0, 1, 0.2), expand = c(0.01, 0))

p_marginal <- ggMarginal(p_main, type = "density", groupColour = TRUE, groupFill = TRUE, margins = "both")

ggsave(filename = "GI_density_ddPCR+FC.png", plot = p_marginal, width = 8.3, height = 6.9, dpi = 600)
