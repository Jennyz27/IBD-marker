# ==============================================================================
# Multi-Center Microbiome Association Analysis using MaAsLin2
# ==============================================================================

library(Maaslin2)
library(dplyr)
library(readr)
library(stringr)
library(ggplot2)
library(ggforce)

# 1. Load Data and Define Metadata/Features -----------------------------------
df_input_data <- read.csv("data.csv", header = TRUE, row.names = 1)

# Separate metadata and feature data
df_input_metadata <- df_input_data[, 1:2]
data <- df_input_data[, 3:ncol(df_input_data)]

# Check group distribution
table(df_input_metadata$group)

# 2. Run MaAsLin2 for All Data Combined ---------------------------------------
fit_data_all <- Maaslin2(
  input_data = data, 
  input_metadata = df_input_metadata, 
  output = "output_all",    
  fixed_effects = c("group"),
  plot_heatmap = TRUE,
  reference = c("group,Controls")
)

# 3. Run MaAsLin2 Stratified by Center ----------------------------------------
centers <- unique(as.character(df_input_metadata$Center))

for (center in centers) {
  current_metadata <- df_input_metadata %>% filter(Center == center)
  current_data <- data[rownames(current_metadata), ] 
  
  if (nrow(current_metadata) > 0 && nrow(current_data) > 0) {
    Maaslin2(
      input_data = current_data, 
      input_metadata = current_metadata, 
      output = paste0("output_", center), 
      fixed_effects = c("group"),
      plot_heatmap = TRUE,
      reference = c("group,Controls") # Fixed: standardized reference format
    )
  } else {
    cat("No data available for center:", center, "\n")
  }
}

# 4. Feature Name Mapping Table -----------------------------------------------
map_df <- data.frame(
  old = c("A181", "A181.1", "BF", "Bha", "Bwa", "Clep", "Csp", "DF", "EC", "Eu274",
          "Fs", "Gf", "Gm", "Lasa", "Ospl", "RINT", "RINU", "RO", "Rt"),
  new = c("Actinomyces_sp_oral_taxon_181_UC", "Actinomyces_sp_oral_taxon_181_CD", 
          "Bacteroides_fragilis", "Blautia_hansenii", "Bilophila_wadsworthia",
          "Clostridium_leptum", "Clostridium_spiroforme", "Dorea_formicigenerans",
          "Escherichia_coli", "Eubacterium_sp_CAG_274",
          "Fusicatenibacter_saccharivorans", "Gemmiger_formicilis", "Gemella_morbillorum", 
          "Lawsonibacter_asaccharolyticus", "Odoribacter_splanchnicus", "Roseburia_intestinalis",
          "Roseburia_inulinivorans", "Blautia_obeum", "Ruminococcus_torques"),
  stringsAsFactors = FALSE
)

# 5. Aggregate Results Across All Centers and Combined Analysis ---------------
analysis_groups <- c(centers, "all")
results_all <- data.frame()

for (g in analysis_groups) {
  out_dir <- paste0("output_", g)
  res_path <- file.path(out_dir, "all_results.tsv")
  
  if (!file.exists(res_path)) next
  
  res_df <- read_tsv(res_path, col_types = cols())
  
  # Select key columns: feature, value, coef, qval
  keep_cols <- c(1, 3, 4, 9)
  if (max(keep_cols) > ncol(res_df)) next
  res_df <- res_df[, keep_cols]
  
  # Map feature names
  res_df$feature <- map_df$new[match(res_df$feature, map_df$old)]
  
  # Transform statistics for visualization
  res_df <- res_df %>%
    mutate(
      label = ifelse(coef > 0, "+", "-"),
      data0 = log10(qval),
      data  = ifelse(label == "-", data0, -data0),
      label = ifelse(qval >= 0.25, " ", label)
    )
  
  # Fixed: Handle metadata subsetting correctly for "all" vs specific centers
  if (g == "all") {
    meta_sub <- df_input_metadata
  } else {
    meta_sub <- df_input_metadata %>% filter(Center == g)
  }
  
  res_df$Comparison <- g
  res_df$n_numer <- sum(meta_sub$group == "IBD")
  res_df$n_denom <- sum(meta_sub$group == "Controls")
  
  results_all <- bind_rows(results_all, res_df)
}

# 6. Process Data for Left Panel (Overall Comet Plot) -------------------------
onlyall <- results_all %>% 
  filter(Comparison == "all") %>%
  filter(feature != "Actinomyces_sp_oral_taxon_181_UC")

onlyall$feature <- gsub("Actinomyces_sp_oral_taxon_181_CD", "Actinomyces_sp_oral_taxon_181", onlyall$feature)

onlyall <- onlyall %>%
  mutate(
    star = case_when(
      qval < 0.001 ~ "***",
      qval < 0.01  ~ "**",
      qval < 0.05  ~ "*",
      qval < 0.25  ~ ".",
      TRUE ~ ""
    )
  ) %>%
  arrange(coef) %>%
  mutate(feature = factor(feature, levels = feature))

# Generate Comet Plot (Optimized: removed duplicate geom_point)
P <- ggplot(onlyall) +
  ggforce::geom_link(aes(x = 0, y = feature, xend = coef, yend = feature,
                         color = ifelse(coef > 0, "#d73027", "#6D9EC1"),
                         alpha = after_stat(index), size = after_stat(index)),
                     n = 800, show.legend = FALSE) +
  geom_point(aes(x = coef, y = feature), color = "black", fill = "white", size = 6, shape = 21) +
  scale_color_identity() +  
  geom_text(data = onlyall %>% filter(coef > 0),
            aes(x = -0.02, y = feature, label = feature),
            hjust = 1, size = 7, fontface = "bold.italic") +
  geom_label(data = onlyall %>% filter(coef > 0),
             aes(x = -0.05, y = feature, label = star),
             fill = alpha("#d73027", 0.5),
             nudge_x = onlyall$coef[onlyall$coef > 0] + 0.15, size = 5) +
  geom_text(data = onlyall %>% filter(coef < 0),
            aes(x = 0.02, y = feature, label = feature),
            hjust = 0, size = 7, fontface = "bold.italic") +
  geom_label(data = onlyall %>% filter(coef < 0),
             aes(x = 0.1, y = feature, label = star),
             fill = alpha("#6D9EC1", 0.5),
             nudge_x = onlyall$coef[onlyall$coef < 0] - 0.2, size = 5) +
  theme_bw() +
  theme(
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),
    panel.grid = element_blank(),
    axis.title.x = element_text(size = 20, face = "bold"),
    axis.text.x = element_text(size = 18, color = "black"),
    panel.border = element_rect(fill = NA, color = "black", size = 1.5, linetype = "solid")
  ) +
  ylab("") +
  xlab("Coefficient")

ggsave("P_maaslin2_all_features.png", P, width = 13.5, height = 10)

# 7. Process Data for Center-wise Heatmap -------------------------------------
results_center <- results_all %>% 
  filter(Comparison != "all") %>%
  filter(feature != "Actinomyces_sp_oral_taxon_181_UC")

results_center$feature <- gsub("Actinomyces_sp_oral_taxon_181_CD", "Actinomyces_sp_oral_taxon_181", results_center$feature)

feature_order <- unique(onlyall$feature)
results_center$feature <- factor(results_center$feature, levels = feature_order)

center_levels <- c(
  "Australia", "Canada", "USA", "Germany", "Austria",
  "Japan", "Taiwan", "Beijing", "Shanghai", "Guangzhou", "Kunming",
  "Malaysia", "Thailand", "Indonesia", "Singapore", "Vietnam", "Myanmar"
)
results_center$Comparison <- factor(results_center$Comparison, levels = center_levels)

# Generate Center Heatmap
pcenter <- ggplot(results_center, aes(feature, Comparison, fill = coef)) + 
  geom_tile(color = "black", fill = "white", size = 0.7) + 
  geom_point(pch = 22, color = "white", size = 8.7) +
  coord_flip() +
  geom_text(aes(label = label), color = "black", size = 6) + 
  scale_fill_gradient2(
    low = '#6D9EC1', high = 'darkred', mid = 'white', midpoint = 0,
    name = "Coefficient", space = "Lab", limit = c(-2.8, 2)
  ) +
  labs(x = NULL, y = NULL) + 
  theme(
    axis.text.x = element_text(size = 15, angle = 270, hjust = 0, vjust = 0.3, color = "black", face = "bold"),
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),
    legend.title = element_text(size = 15, angle = 90, vjust = 1, face = "bold"),
    legend.text = element_text(size = 15),
    panel.grid.major = element_blank(), 
    panel.background = element_blank()
  ) +
  geom_rect(aes(ymin = 0.45, ymax = 5.5, xmin = 18.6, xmax = 19.6), fill = '#CEE0EF', color = 'white') +
  geom_rect(aes(ymin = 5.5, ymax = 11.5, xmin = 18.6, xmax = 19.6), fill = '#7BABD3', color = 'white') +
  geom_rect(aes(ymin = 11.5, ymax = 17.55, xmin = 18.6, xmax = 19.6), fill = '#508FC5', color = 'white') +
  annotate('text', label = 'Whites', y = 3, x = 19.1, size = 6) +
  annotate('text', label = 'Eastern Asia', y = 8.7, x = 19.1, size = 6) + 
  annotate('text', label = 'Southeastern Asia', y = 14.5, x = 19.1, size = 6)

ggsave("maaslin2_heatmap.png", plot = pcenter, width = 10, height = 9)
