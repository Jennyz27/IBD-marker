                         sum(data_val$group == "IBD"),
                         ") vs Controls(",
                         sum(data_val$group == "Controls"), ")")

p_val <- plot_roc_ci(data_val, "group", "ddpcr_model_POD",
                     positive_class = "IBD", negative_class = "Controls",
                     title_text = title_text_val,
                     threshold = round(best_threshold_ddpcr_val, 3))
