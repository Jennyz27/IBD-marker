# ==============================================================================
# ROC Curve Analysis and Multi-Panel Plotting for GI Cohorts
# ==============================================================================

library(pROC)
library(ggplot2)
library(patchwork)
library(dplyr)

# 1. Theme and Color Settings
mycol   <- "#B60A1C"
fillcol <- "#f8766d"

# 2. Reusable ROC Plotting Function with CI and Threshold Marker
plot_roc_ci <- function(data, label_col, score_col,
                        positive_class, negative_class,
                        title_text, threshold) {
  df <- data %>%
    dplyr::filter(!!sym(label_col) %in% c(positive_class, negative_class)) %>%
    dplyr::mutate(binary_label = factor(!!sym(label_col),
                                        levels = c(negative_class, positive_class)))
  
  roc_obj  <- pROC::roc(df$binary_label, df[[score_col]],
                        levels = c(negative_class, positive_class),
                        direction = "<")
  auc_val  <- round(pROC::auc(roc_obj), 4)
  
  # Calculate sensitivity and specificity at the optimal threshold
  coords_df <- pROC::coords(roc_obj, x = threshold, input = "threshold",
                            ret = c("sensitivity", "specificity"))
  sens <- round(coords_df["sensitivity"], 2)
  spec <- round(coords_df["specificity"], 2)
  
  # Compute confidence intervals for ROC curve
  ci_obj <- pROC::ci.se(roc_obj, specificities = seq(0, 1, length.out = 25))
  ci_df  <- data.frame(
    x     = as.numeric(rownames(ci_obj)),
    lower = ci_obj[, 1],
    upper = ci_obj[, 3]
  )
  
  p <- pROC::ggroc(list(data = roc_obj), legacy.axes = TRUE, size = 1.2) +
    theme_bw() +
    xlab("1 - Specificity") +
    ylab("Sensitivity") +
    ggtitle(title_text) +
    theme(
      legend.position = "none",
      plot.title      = element_text(size = 20, color = "black", face = "bold", hjust = 0.5),
      axis.title      = element_text(size = 18, face = "bold", color = "black"),
      axis.text       = element_text(size = 18, color = "black"),
      panel.grid      = element_blank(),
      panel.background = element_rect(color = 'black', fill = 'transparent'),
      panel.border    = element_rect(fill = NA, color = "black", size = 1.1)
    ) +
    scale_x_continuous(expand = c(0.01, 0)) +
    scale_y_continuous(expand = c(0.01, 0)) +
    geom_segment(aes(x = 0, xend = 1, y = 0, yend = 1),
                 color = "black", size = 0.6, linetype = 2) +
    scale_colour_manual(values = mycol) +
    annotate("text", x = 0.9, y = 0.2,
             label = paste0("AUC = ", formatC(auc_val, format = "f", digits = 2)),
             size = 10, hjust = 1) +
    geom_ribbon(data = ci_df,
                aes(x = 1 - x, ymin = lower, ymax = upper),
                fill = fillcol, alpha = 0.2, inherit.aes = FALSE) +
    geom_point(aes(x = as.numeric(1 - spec), y = as.numeric(sens)),
               color = "blue", size = 3) +
    annotate("text", x = as.numeric(1 - spec), y = as.numeric(sens + 0.05),
             label = paste0("Threshold = ", threshold,
                            "\nSens = ", sens,
                            "\nSpec = ", spec),
             size = 6, hjust = 0.5, color = "blue")
  
  return(p)
}

# ==============================================================================
# 3. Analysis and Plotting for Cohort 182
# ==============================================================================
best_threshold_ddpcr <- 0.680
best_threshold_fc_ddpcr <- 0.682

title_text_182 <- paste0("IBD(", sum(data182_FC_ddpcr$group == "IBD"), 
                         ") vs Controls(", sum(data182_FC_ddpcr$group == "Controls"), ")")

# Generate individual panels: FC alone, Bacterial model, Combined model
p_fc <- plot_roc_ci(data182_FC_ddpcr, "group", "FC", "IBD", "Controls", title_text_182, threshold = 100)
p_bac <- plot_roc_ci(data182_FC_ddpcr, "group", "IBD", "IBD", "Controls", title_text_182, threshold = round(best_threshold_ddpcr, 3))
p_combo <- plot_roc_ci(data182_FC_ddpcr, "group", "IBD", "IBD", "Controls", title_text_182, threshold = round(best_threshold_fc_ddpcr, 3))

# Combine plots using patchwork
p_combined_182 <- p_fc + p_bac + p_combo
print(p_combined_182)

ggsave("gi_cohort_182.png", p_combined_182, width = 15, height = 5.2, dpi = 600)

