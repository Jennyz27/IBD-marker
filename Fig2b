}

run_Model4 <- function(features, metadata, output_base_dir = "maaslin2_results") {
  output_dir <- file.path(output_base_dir, "Model4")
  complete_data <- metadata %>% 
    filter(!is.na(Age) & !is.na(Gender) & !is.na(Ethnicity) & !is.na(Disease_status) & !is.na(Mesalazine) & !is.na(Steriods) & !is.na(Immunosuppressant) & !is.na(Biologics))
