# ==============================================================================
# Multi-Model Confounder Adjustment and Forest Plot Visualization using MaAsLin2
# ==============================================================================

library(Maaslin2)
library(dplyr)
library(tidyr)
library(ggplot2)

# 1. Load Data and Preprocess Metadata ----------------------------------------
df_input_metadata1 <- read.csv("df_input_metadata.csv", row.names = 1)
df_input_data <- read.csv("df_input_data.csv", row.names = 1)

# Convert all metadata columns except Age and BMI to factors
cols_to_factor <- setdiff(names(df_input_metadata1), c("Age", "BMI"))
df_input_metadata1[cols_to_factor] <- lapply(df_input_metadata1[cols_to_factor], factor)

marker_df <- df_input_data
metadata_df <- df_input_metadata1

# Transpose marker matrix (MaAsLin2 requires features as columns and samples as rows)
features <- t(marker_df) 
marker_names <- colnames(marker_df)

# 2. Helper Functions for Maaslin2 Analysis -----------------------------------
generate_references <- function(metadata, fixed_effects, random_effects = NULL) {
  all_effects <- c(fixed_effects, random_effects)
  references <- c()
  
  for (effect in all_effects) {
    if (effect %in% colnames(metadata)) {
      if (is.factor(metadata[[effect]]) && nlevels(metadata[[effect]]) >= 2) {
        ref_level <- levels(metadata[[effect]])[1]
        references <- c(references, paste0(effect, ",", ref_level))
      }
    }
  }
  return(references)
}

run_maaslin2_analysis <- function(features, metadata, fixed_effects = NULL, 
                                  random_effects = NULL, output_dir, level_name) {
  cat(paste0("Running MaAsLin2 for: ", level_name, "\n"))
  dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
  
  references <- generate_references(metadata, fixed_effects, random_effects)
  
  if ("Disease_status" %in% colnames(metadata)) {
    if (!"Disease_status,Controls" %in% references) {
      references <- c("Disease_status,Controls", references)
    }
  }
  
  fit_data <- Maaslin2(
    input_data = features,
    input_metadata = metadata,
    output = output_dir,
    fixed_effects = fixed_effects,
    random_effects = random_effects,
    reference = references,
    cores = 4
  )
  
  return(list(
    results = fit_data$results,
    fit_data = fit_data,
    output_dir = output_dir
  ))
}

# 3. Define Analysis Models (Model 0 to Model 5) -------------------------------

run_Model0 <- function(features, metadata, output_base_dir = "maaslin2_results") {
  output_dir <- file.path(output_base_dir, "Model0")
  res <- run_maaslin2_analysis(features, metadata, fixed_effects = c("Disease_status"), 
                               output_dir = output_dir, level_name = "Model0 (Crude)")
  filtered_res <- res$results %>% filter(metadata == "Disease_status" & value == "IBD")
  return(list(results = filtered_res, fit_data = res$fit_data, output_dir = res$output_dir))
}

run_Model1 <- function(features, metadata, output_base_dir = "maaslin2_results") {
  output_dir <- file.path(output_base_dir, "Model1")
  complete_data <- metadata %>% filter(!is.na(Age) & !is.na(Gender) & !is.na(Ethnicity) & !is.na(Disease_status))
  complete_features <- features[, rownames(complete_data)]
  
  res <- run_maaslin2_analysis(complete_features, complete_data, 
                               fixed_effects = c("Disease_status", "Age", "Gender"), 
                               random_effects = c("Ethnicity"), 
                               output_dir = output_dir, level_name = "Model1 (Basic)")
  filtered_res <- res$results %>% filter(metadata == "Disease_status" & value == "IBD")
  return(list(results = filtered_res, fit_data = res$fit_data, data_used = complete_data, output_dir = res$output_dir))
}

run_Model2 <- function(features, metadata, output_base_dir = "maaslin2_results") {
  output_dir <- file.path(output_base_dir, "Model2")
  metadata_adj <- metadata %>%
    mutate(
      Group_adj = ifelse(Disease_status == "Controls", "CD", as.character(Group)),
      Group_adj = factor(Group_adj, levels = c("CD", "UC")),
      activity_adj = ifelse(Disease_status == "Controls", "InActive", as.character(Disease_activity_act_inac)),
      activity_adj = factor(activity_adj, levels = c("InActive", "Active"))
    )
  
  complete_data <- metadata_adj %>% 
    filter(!is.na(Age) & !is.na(Gender) & !is.na(Ethnicity) & !is.na(Disease_status) & !is.na(Group_adj) & !is.na(activity_adj))
  complete_features <- features[, rownames(complete_data)]
  
  res <- run_maaslin2_analysis(complete_features, complete_data, 
                               fixed_effects = c("Disease_status", "Age", "Gender", "Group_adj", "activity_adj"), 
                               random_effects = c("Ethnicity"), 
                               output_dir = output_dir, level_name = "Model2 (Basic + Disease Characteristics)")
  filtered_res <- res$results %>% filter(metadata == "Disease_status" & value == "IBD")
  return(list(results = filtered_res, fit_data = res$fit_data, data_used = complete_data, output_dir = res$output_dir))
}

