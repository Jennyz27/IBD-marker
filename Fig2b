run_Model5 <- function(features, metadata, output_base_dir = "maaslin2_results") {
  output_dir <- file.path(output_base_dir, "Model5")
  metadata_adj <- metadata %>%
    mutate(
      Group_adj = ifelse(Disease_status == "Controls", "CD", as.character(Group)),
      Group_adj = factor(Group_adj, levels = c("CD", "UC")),
      activity_adj = ifelse(Disease_status == "Controls", "InActive", as.character(Disease_activity_act_inac)),
      activity_adj = factor(activity_adj, levels = c("InActive", "Active"))
    )
  
  complete_data <- metadata_adj %>% 
    filter(!is.na(Age) & !is.na(Gender) & !is.na(Ethnicity) & !is.na(Disease_status) & !is.na(BMI) & 
           !is.na(Smoke) & !is.na(Alcohol) & !is.na(Vegetarian_status) & !is.na(Mesalazine) & 
           !is.na(Steriods) & !is.na(Immunosuppressant) & !is.na(Biologics) & !is.na(Group_adj) & !is.na(activity_adj))
  complete_features <- features[, rownames(complete_data)]
  
  res <- run_maaslin2_analysis(complete_features, complete_data, 
                               fixed_effects = c("Disease_status", "Age", "Gender", "BMI", "Smoke", "Alcohol", 
                                                 "Vegetarian_status", "Mesalazine", "Steriods", "Immunosuppressant", 
                                                 "Biologics", "Group_adj", "activity_adj"), 
                               random_effects = c("Ethnicity"), 
                               output_dir = output_dir, level_name = "Model5 (Full Model)")
  filtered_res <- res$results %>% filter(metadata == "Disease_status" & value == "IBD")
  return(list(results = filtered_res, fit_data = res$fit_data, data_used = complete_data, output_dir = res$output_dir))
}

# Execute All Models
analysis_results <- list(
  Model0 = run_Model0(features, metadata_df),
  Model1 = run_Model1(features, metadata_df),
  Model2 = run_Model2(features, metadata_df),
  Model3 = run_Model3(features, metadata_df),
  Model4 = run_Model4(features, metadata_df),
  Model5 = run_Model5(features, metadata_df)
)

# 4. Collect and Format Results for Visualization -----------------------------
all_data <- data.frame()

for (level_name in names(analysis_results)) {
  level_results <- analysis_results[[level_name]]$results
  if (!is.null(level_results) && nrow(level_results) > 0) {
    temp_df <- level_results %>%
      mutate(
        level = level_name,
        ci_lower = coef - 1.96 * stderr,
        ci_upper = coef + 1.96 * stderr,
        significant = qval < 0.25
      )
    all_data <- rbind(all_data, temp_df)
  }
}

# Feature Name Mapping
map_df <- data.frame(
  old = c("A181", "A181.1", "BF", "Bha", "Bwa", "Clep", "Csp", "DF", "EC", "Eu274",
          "Fs", "Gf", "Gm", "Lasa", "Ospl", "RINT", "RINU", "RO", "Rt"),
