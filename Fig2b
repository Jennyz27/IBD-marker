          "FS", "GF", "GM", "LA", "OS", "RINT", "RINU", "BO", "RT")
)

all_data$feature <- map_df$new[match(all_data$feature, map_df$old)]
all_data <- all_data %>% 
  filter(feature != "AS_UC")

all_data$feature <- gsub("AS_CD", "AS", all_data$feature)

all_data$feature <- factor(all_data$feature, levels = c(
  "BH", "EC", "AS", "GM", "CS", "BF", "BW", "DF", "ES", "RT", 
  "GF", "RINT", "RINU", "LA", "OS", "BO", "CL", "FS"
))

all_data$level <- gsub("Model0", "Crude Model", all_data$level)
all_data$level <- factor(all_data$level, levels = c("Model5", "Model4", "Model3", "Model2", "Model1", "Crude Model"))

# 5. Generate Faceted Forest Plot ---------------------------------------------
level_colors <- c(
  "Crude Model" = "#85BA8F", 
  "Model1"      = "#349839", 
  "Model2"      = "#F09594",
  "Model3"      = "#EA5D2D",
  "Model4"      = "#A3C8DC",
  "Model5"      = "#2072A8"
)

forest_plot <- ggplot(all_data, aes(x = coef, y = level)) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "gray50", alpha = 0.7) +
  geom_errorbarh(aes(xmin = ci_lower, xmax = ci_upper, color = level), height = 0.5, linewidth = 1.2, alpha = 0.7) +
  geom_point(aes(color = level, shape = significant), size = 4) +
  facet_wrap(~ feature, ncol = 6) +
  scale_color_manual(
    values = level_colors, 
    breaks = c("Crude Model", "Model1", "Model2", "Model3", "Model4", "Model5"),
    labels = c(
      "Crude Model" = "Crude Model",
      "Model1"      = "Model 1: Basic (Age+Gender+Geography)",
      "Model2"      = "Model 2: Basic + Disease Characteristics",
      "Model3"      = "Model 3: Basic + Lifestyle Factors",
      "Model4"      = "Model 4: Basic + Medication",
      "Model5"      = "Model 5: Full Model"
    )
  ) +
  scale_shape_manual(
    values = c("TRUE" = 16, "FALSE" = 1),
    labels = c("TRUE" = "Significant (q < 0.25)", "FALSE" = "Not Significant")
  ) +
  labs(
    x = "Coefficient (IBD vs Controls)", 
    title = "Forest Plot of Bacterial Markers Association with IBD",
    subtitle = "Error bars represent 95% confidence intervals"
  ) +
  theme_minimal(base_size = 18) +
  theme(
    panel.grid.major = element_line(color = "grey90", linewidth = 0.2),
    panel.grid.minor = element_blank(),
    strip.background = element_rect(fill = "grey85", color = NA),
    strip.text = element_text(face = "bold", size = 18),
    axis.title.x = element_text(size = 20, face = "bold", color = "black"),
    axis.title.y = element_blank(),
    axis.text.y = element_text(size = 18, color = "black"),
    axis.text.x = element_text(size = 18, color = "black"),
    legend.position = "bottom",
    legend.text = element_text(size = 18, color = "black"),
    legend.title = element_text(size = 18, face = "bold"),
    plot.title = element_text(face = "bold", size = 14, hjust = 0),
    plot.subtitle = element_text(size = 16, hjust = 0, color = "grey40"),
    plot.margin = margin(20, 20, 20, 20)
  ) +
  guides(
    color = guide_legend(title = "Analysis Level", nrow = 3),
    shape = guide_legend(title = "Statistical Significance", nrow = 2, byrow = TRUE)
  )

print(forest_plot)

# Save Outputs
ggsave("forest_plot_final20261012.png", plot = forest_plot, width = 18.3, height = 10, dpi = 600)
